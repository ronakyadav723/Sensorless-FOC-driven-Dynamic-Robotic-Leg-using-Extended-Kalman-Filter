<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <gravity>0 0 -9.8</gravity>

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -2 0.5 0 0.15 1.5708</pose>
      </camera>
    </gui>

  </world>
</sdf>
